#!/bin/bash

# omarchy:summary=Change a user's supplementary groups (pick, add, remove, or set)
# omarchy:args=[username] [--add g1,g2] [--remove g1,g2] [--set g1,g2] [--yes] [--force-lockout]
# omarchy:examples=omarchy-change-groups | omarchy-change-groups alice --add docker --yes

set -euo pipefail

PROG="omarchy-change-groups"
ASSUME_YES=0
FORCE_LOCKOUT=0
USERNAME=""
ADD_ARG=""
REMOVE_ARG=""
SET_ARG=""

fail() {
  echo "$PROG: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

show_logo() {
  if interactive && [[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/logo.txt ]]; then
    echo -e "\033[32m"
    cat <"$OMARCHY_PATH/logo.txt"
    echo -e "\033[0m"
    echo
  fi
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

need_gum() {
  command -v gum >/dev/null 2>&1 || fail "gum is required for the interactive menu"
}

login_users() {
  getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | sort
}

# Only an unrestricted rule such as "(ALL) ALL" or "(ALL : ALL) NOPASSWD: ALL"
# counts; a grant limited to some commands does not make an administrator.
full_sudo_grant() {
  local list
  list=$(LC_ALL=C sudo -l -U "$1" 2>/dev/null) || return 1
  grep -Eq '^[[:space:]]*\((ALL|root)([[:space:]]*:[^)]*)?\)[[:space:]]+([A-Z]+:[[:space:]]*)*ALL[[:space:]]*$' <<<"$list"
}

# Another login user counts as an administrator through wheel or an
# unrestricted sudo grant.
other_admin_exists() {
  local candidate groups
  while IFS= read -r candidate; do
    [[ $candidate != "$USERNAME" ]] || continue
    groups=$(id -nG "$candidate") || groups=""
    [[ " $groups " == *" wheel "* ]] && return 0
    full_sudo_grant "$candidate" && return 0
  done < <(login_users)
  return 1
}

CURATED_GROUPS="wheel video audio optical storage input scanner network power uucp docker"

existing_groups() {
  local g out=""
  for g in $CURATED_GROUPS; do
    if getent group "$g" >/dev/null; then
      out+="$g"$'\n'
    fi
  done
  printf '%s' "$out"
}

# Primary group never changes here; only supplementary groups are managed.
primary_group() {
  id -gn "$1"
}

supplementary_groups() {
  local primary current g out=""
  primary=$(primary_group "$1")
  current=$(id -nG "$1")
  for g in $current; do
    [[ $g != "$primary" ]] || continue
    out+="$g "
  done
  printf '%s' "${out% }"
}

check_groups_exist() {
  local csv="$1" g
  IFS=',' read -ra arr <<<"$csv"
  for g in "${arr[@]}"; do
    [[ -n $g ]] || fail "empty group name in '$csv'"
    getent group "$g" >/dev/null || fail "unknown group: $g"
  done
}

while (( $# > 0 )); do
  case "$1" in
  --add)
    [[ -n ${2:-} && $2 != -* ]] || fail "--add needs a comma-separated list"
    [[ -z $ADD_ARG && -z $SET_ARG ]] || fail "combine --add/--remove, or use --set alone"
    ADD_ARG="$2"
    shift 2
    ;;
  --remove)
    [[ -n ${2:-} && $2 != -* ]] || fail "--remove needs a comma-separated list"
    [[ -z $REMOVE_ARG && -z $SET_ARG ]] || fail "combine --add/--remove, or use --set alone"
    REMOVE_ARG="$2"
    shift 2
    ;;
  --set)
    [[ -n ${2:-} && $2 != -* ]] || fail "--set needs a comma-separated list"
    [[ -z $ADD_ARG && -z $REMOVE_ARG && -z $SET_ARG ]] || fail "combine --add/--remove, or use --set alone"
    SET_ARG="$2"
    shift 2
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  --force-lockout)
    FORCE_LOCKOUT=1
    shift
    ;;
  -h | --help)
    echo "Usage: $PROG [username] [--add g1,g2] [--remove g1,g2] [--set g1,g2] [--yes] [--force-lockout]"
    echo
    echo "Changes a user's supplementary groups. The primary group is never"
    echo "touched. --add/--remove adjust the current set, --set replaces it."
    echo
    echo "With no group flags it shows a gum checklist preselected with the"
    echo "user's current groups; the checked set becomes the new set."
    echo "Removing your own wheel membership, or wheel from the last"
    echo "administrator (wheel member or full sudo grant), needs"
    echo "--force-lockout, even with --yes or a managed sudo drop-in."
    exit 0
    ;;
  -*)
    fail "unknown option: $1 (try --help)"
    ;;
  *)
    [[ -z $USERNAME ]] || fail "unexpected argument: $1"
    USERNAME="$1"
    shift
    ;;
  esac
done

show_logo

if [[ -z $USERNAME ]]; then
  interactive || fail "a username is required"
  need_gum
  USERNAME=$(login_users | gum choose --header="Change groups for which user?") || fail "cancelled"
  [[ -n $USERNAME ]] || fail "nothing selected"
fi
entry=$(getent passwd "$USERNAME") || fail "no such user: $USERNAME"
[[ ${entry%%:*} == "$USERNAME" ]] || fail "no such user: $USERNAME (use the login name, not a UID)"

current=$(supplementary_groups "$USERNAME")
final=""

if [[ -n $SET_ARG ]]; then
  check_groups_exist "$SET_ARG"
  final="$SET_ARG"
elif [[ -n $ADD_ARG || -n $REMOVE_ARG ]]; then
  [[ -n $ADD_ARG ]] && check_groups_exist "$ADD_ARG"
  [[ -n $REMOVE_ARG ]] && check_groups_exist "$REMOVE_ARG"
  # Union of current + added, minus removed.
  declare -A keep=()
  g=""
  for g in $current; do keep[$g]=1; done
  IFS=',' read -ra arr <<<"${ADD_ARG:-}"
  for g in ${arr[@]+"${arr[@]}"}; do [[ -n $g ]] && keep[$g]=1; done
  IFS=',' read -ra arr <<<"${REMOVE_ARG:-}"
  for g in ${arr[@]+"${arr[@]}"}; do [[ -n $g ]] && unset "keep[$g]"; done
  final=$(printf '%s,' "${!keep[@]}")
  final="${final%,}"
else
  interactive || fail "a group change is required (--add, --remove, or --set)"
  need_gum
  options=$(printf '%s\n%s' "$(existing_groups)" "$current" | tr ' ' '\n' | awk NF | awk '!seen[$0]++')
  selected=""
  if [[ -n $current ]]; then
    want="--selected=$(printf '%s' "$current" | tr ' ' ',')"
    selected=$(printf '%s' "$options" | gum choose --no-limit "$want" --header="Groups for $USERNAME? (space to toggle)") || fail "cancelled"
  else
    selected=$(printf '%s' "$options" | gum choose --no-limit --header="Groups for $USERNAME? (space to toggle)") || fail "cancelled"
  fi
  final=$(printf '%s' "$selected" | tr '\n' ',' | sed 's/,$//')
fi

echo
echo "Group change for $USERNAME (primary: $(primary_group "$USERNAME") untouched):"
echo "  before: ${current:-<none>}"
echo "  after:  ${final:-<none>}"
current_csv=$(printf '%s' "$current" | tr ' ' '\n' | awk NF | sort | tr '\n' ',')
final_csv=$(printf '%s' "$final" | tr ',' '\n' | awk NF | sort | tr '\n' ',')
[[ "$current_csv" != "$final_csv" ]] || fail "no change - groups already match"
if [[ " $current " == *" wheel "* && ",$final," != *,wheel,* ]]; then
  # A drop-in or a successful sudo check cannot prove that access survives
  # removing wheel: sudo may ignore the file or grant access through wheel.
  if (( ! FORCE_LOCKOUT )); then
    [[ $USERNAME != "${SUDO_USER:-$(id -un)}" ]] ||
      fail "refusing to remove your own wheel membership. Sign in as another administrator, or use --force-lockout only with a recovery path"
    other_admin_exists ||
      fail "no other administrator found. Add another login user to wheel first, or use --force-lockout only with a recovery path"
  fi
fi
confirm "Apply this group change?" || fail "aborted"

# -G replaces the supplementary set; the primary group is unaffected.
# An empty set clears supplementary groups.
sudo usermod -G "$final" -- "$USERNAME"

echo "Groups for $USERNAME now: $(supplementary_groups "$USERNAME" | tr ' ' ',' | sed 's/^$/<none>/')"
echo "Takes effect on next login."
