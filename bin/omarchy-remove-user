#!/bin/bash

# omarchy:summary=Remove a login user, optionally its home and sudo grant
# omarchy:args=[username] [--remove-home|--keep-home] [--yes] [--force-lockout]
# omarchy:examples=omarchy-remove-user | omarchy-remove-user alice --remove-home --yes

set -euo pipefail

PROG="omarchy-remove-user"
ASSUME_YES=0
FORCE_LOCKOUT=0
USERNAME=""
HOME_MODE=""

fail() {
  echo "$PROG: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

show_logo() {
  if interactive && [[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/logo.txt ]]; then
    echo -e "\033[32m"
    cat <"$OMARCHY_PATH/logo.txt"
    echo -e "\033[0m"
    echo
  fi
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

need_gum() {
  command -v gum >/dev/null 2>&1 || fail "gum is required for the interactive menu"
}

# Login users: real accounts (UID 1000..59999), one per line.
login_users() {
  getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | sort
}

managed_sudoers_file() {
  local file=$1 user=$2 rule
  sudo test -f "$file" && ! sudo test -L "$file" || return 1
  for rule in "$user ALL=(ALL) ALL" "$user ALL=(ALL) NOPASSWD: ALL"; do
    if sudo cat -- "$file" | cmp -s - <(printf '%s\n' "$rule"); then
      return 0
    fi
  done
  return 1
}

# Only an unrestricted rule such as "(ALL) ALL" or "(ALL : ALL) NOPASSWD: ALL"
# counts; a grant limited to some commands does not make an administrator.
full_sudo_grant() {
  local list
  list=$(LC_ALL=C sudo -l -U "$1" 2>/dev/null) || return 1
  grep -Eq '^[[:space:]]*\((ALL|root)([[:space:]]*:[^)]*)?\)[[:space:]]+([A-Z]+:[[:space:]]*)*ALL[[:space:]]*$' <<<"$list"
}

# Another login user counts as an administrator through wheel or an
# unrestricted sudo grant.
other_admin_exists() {
  local candidate groups
  while IFS= read -r candidate; do
    [[ $candidate != "$USERNAME" ]] || continue
    groups=$(id -nG "$candidate") || groups=""
    [[ " $groups " == *" wheel "* ]] && return 0
    full_sudo_grant "$candidate" && return 0
  done < <(login_users)
  return 1
}

while (( $# > 0 )); do
  case "$1" in
  --remove-home)
    [[ -z $HOME_MODE ]] || fail "pass only one of --remove-home, --keep-home"
    HOME_MODE="remove"
    shift
    ;;
  --keep-home)
    [[ -z $HOME_MODE ]] || fail "pass only one of --remove-home, --keep-home"
    HOME_MODE="keep"
    shift
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  --force-lockout)
    FORCE_LOCKOUT=1
    shift
    ;;
  -h | --help)
    echo "Usage: $PROG [username] [--remove-home|--keep-home] [--yes] [--force-lockout]"
    echo
    echo "Removes a login user. Never touches root, system accounts (UID < 1000),"
    echo "or the account running this script. A sudoers drop-in is removed only"
    echo "when it contains exactly one managed rule. An unfamiliar file stops"
    echo "removal before the account is touched. Removing the last"
    echo "administrator (wheel member or full sudo grant) needs"
    echo "--force-lockout."
    echo
    echo "With no arguments it lets you pick the user with gum."
    exit 0
    ;;
  -*)
    fail "unknown option: $1 (try --help)"
    ;;
  *)
    [[ -z $USERNAME ]] || fail "unexpected argument: $1"
    USERNAME="$1"
    shift
    ;;
  esac
done

show_logo

if [[ -z $USERNAME ]]; then
  interactive || fail "a username is required"
  need_gum
  USERNAME=$(login_users | gum choose --header="Remove which user?") || fail "cancelled"
  [[ -n $USERNAME ]] || fail "nothing selected"
fi

entry=$(getent passwd "$USERNAME") || fail "no such user: $USERNAME"
IFS=: read -r name _ uid gid _ home _ <<<"$entry"
# getent also resolves numeric UIDs; without this "1000" would slip past the
# own-account check below and reach loginctl terminate-user.
[[ $name == "$USERNAME" ]] || fail "no such user: $USERNAME (use the login name, not a UID)"
(( uid == 0 )) && fail "refusing to remove root"
(( uid >= 1000 && uid < 60000 )) || fail "refusing to remove system account '$USERNAME' (UID $uid)"
[[ $USERNAME != "${SUDO_USER:-$(whoami)}" ]] || fail "refusing to remove your own account"

sudoers_file="/etc/sudoers.d/$USERNAME"
if sudo test -e "$sudoers_file" || sudo test -L "$sudoers_file"; then
  managed_sudoers_file "$sudoers_file" "$USERNAME" ||
    fail "$sudoers_file is not exactly one managed rule for $USERNAME. Inspect it with 'sudo visudo -f $sudoers_file' before removing the account"
fi

groups=$(id -nG "$USERNAME") || fail "cannot read groups for $USERNAME"
if [[ " $groups " == *" wheel "* ]] || sudo -l -U "$USERNAME" >/dev/null 2>&1; then
  if (( ! FORCE_LOCKOUT )) && ! other_admin_exists; then
    fail "no other administrator found. Add another login user to wheel first, or use --force-lockout only with a recovery path"
  fi
fi

if [[ -z $HOME_MODE ]]; then
  if interactive; then
    need_gum
    if gum choose --header="Home directory $home?" "Keep home directory" "Remove home directory" | grep -q Remove; then
      HOME_MODE="remove"
    else
      HOME_MODE="keep"
    fi
  else
    HOME_MODE="keep"
  fi
fi

echo
echo "About to remove:"
echo "  user: $USERNAME (UID $uid)"
echo "  home: $home ($HOME_MODE)"
confirm "Remove user $USERNAME? This cannot be undone." || fail "aborted"

# Recheck before userdel so a changed file aborts with the account intact.
if sudo test -e "$sudoers_file" || sudo test -L "$sudoers_file"; then
  managed_sudoers_file "$sudoers_file" "$USERNAME" ||
    fail "$sudoers_file changed; inspect it with 'sudo visudo -f $sudoers_file' before retrying. The account was not removed"
fi

# Log the user out first so userdel doesn't fail on a live session.
sudo loginctl terminate-user "$USERNAME" >/dev/null 2>&1 || true

if [[ $HOME_MODE == "remove" ]]; then
  sudo userdel -r -- "$USERNAME"
else
  sudo userdel -- "$USERNAME"
fi

# A changed file must never be removed as ours, but the account is already
# gone, so warn instead of failing.
if sudo test -e "$sudoers_file" || sudo test -L "$sudoers_file"; then
  if managed_sudoers_file "$sudoers_file" "$USERNAME"; then
    sudo rm -- "$sudoers_file"
    echo "Removed managed sudo grant $sudoers_file."
  else
    echo "WARNING: $sudoers_file changed while the account was being removed and was left in place. Inspect it with 'sudo visudo -f $sudoers_file' before reusing this login name." >&2
  fi
fi

id "$USERNAME" &>/dev/null && fail "user '$USERNAME' still exists"
echo "Removed $USERNAME."
