#!/bin/bash

# omarchy:summary=Create a login user with groups, password, and optional sudo
# omarchy:args=[username] [--groups g1,g2] [--sudo|--sudo-nopasswd|--no-sudo] [--skip-password] [--yes]
# omarchy:examples=omarchy-add-user | omarchy-add-user alice --groups wheel --sudo --yes

set -euo pipefail

PROG="omarchy-add-user"
ASSUME_YES=0
USERNAME=""
GROUPS_ARG=""
GROUPS_GIVEN=0
SUDO_ARG=""
SKIP_PASSWORD=0

fail() {
  echo "$PROG: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

show_logo() {
  if interactive && [[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/logo.txt ]]; then
    echo -e "\033[32m"
    cat <"$OMARCHY_PATH/logo.txt"
    echo -e "\033[0m"
    echo
  fi
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

valid_username() {
  [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]
}

need_gum() {
  command -v gum >/dev/null 2>&1 || fail "gum is required for the interactive menu"
}

# Groups worth offering on an Omarchy desktop. wheel is the admin group
# (polkit administrator: root via pkexec/run0 with the user's own password,
# sudo grant or not); the rest grant hardware/device access. None are needed
# for a plain desktop user. Filtered at runtime to groups that actually exist
# on this machine.
CURATED_GROUPS="wheel video audio optical storage input scanner network power uucp docker"

existing_groups() {
  local g out=""
  for g in $CURATED_GROUPS; do
    if getent group "$g" >/dev/null; then
      out+="$g"$'\n'
    fi
  done
  printf '%s' "$out"
}

while (( $# > 0 )); do
  case "$1" in
  --groups)
    [[ $# -ge 2 && $2 != -* ]] || fail "--groups needs a comma-separated list (\"\" for none)"
    GROUPS_ARG="$2"
    GROUPS_GIVEN=1
    shift 2
    ;;
  --sudo | --sudo-nopasswd | --no-sudo)
    [[ -z $SUDO_ARG ]] || fail "pass only one of --sudo, --sudo-nopasswd, --no-sudo"
    SUDO_ARG="${1#--}"
    shift
    ;;
  --skip-password)
    SKIP_PASSWORD=1
    shift
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: $PROG [username] [--groups g1,g2] [--sudo|--sudo-nopasswd|--no-sudo] [--skip-password] [--yes]"
    echo
    echo "Creates a login user, puts it in the given groups (default: none),"
    echo "sets its password via passwd, and optionally grants sudo through a"
    echo "validated /etc/sudoers.d/<username> drop-in. Refuses to create the"
    echo "user while a sudoers drop-in with that name already exists."
    echo
    echo "The wheel group makes the user an administrator: wheel members can"
    echo "become root through polkit (pkexec, run0) with their own password,"
    echo "with or without a sudo grant."
    echo
    echo "With no arguments it walks you through each step with gum."
    exit 0
    ;;
  -*)
    fail "unknown option: $1 (try --help)"
    ;;
  *)
    [[ -z $USERNAME ]] || fail "unexpected argument: $1"
    USERNAME="$1"
    shift
    ;;
  esac
done

show_logo

if [[ -z $USERNAME ]]; then
  interactive || fail "a username is required"
  need_gum
  USERNAME=$(gum input --placeholder "alice" --prompt "Username: ") || fail "cancelled"
  [[ -n $USERNAME ]] || fail "nothing entered"
fi
valid_username "$USERNAME" || fail "invalid username '$USERNAME' (lowercase letters, digits, _ or -)"
id "$USERNAME" &>/dev/null && fail "user '$USERNAME' already exists (see omarchy-change-groups)"

# Any drop-in already under this name is stale: it would hand the new account
# sudo, or be overwritten below. Stop before creating anything.
sudoers_file="/etc/sudoers.d/$USERNAME"
if sudo test -e "$sudoers_file" || sudo test -L "$sudoers_file"; then
  fail "$sudoers_file already exists and would apply to the new account. Inspect it with 'sudo visudo -f $sudoers_file' and remove it before creating $USERNAME"
fi

# No groups is the default: a plain desktop user needs none.
if (( ! GROUPS_GIVEN )) && interactive; then
  need_gum
  GROUPS_ARG=$(existing_groups | gum choose --no-limit --header="Groups for $USERNAME? (space to toggle, none is fine; wheel = administrator)") || fail "cancelled"
  GROUPS_ARG=$(printf '%s' "$GROUPS_ARG" | tr '\n' ',' | sed 's/,$//')
fi
IFS=',' read -ra GROUP_ARR <<<"$GROUPS_ARG"
for g in ${GROUP_ARR[@]+"${GROUP_ARR[@]}"}; do
  [[ -n $g ]] || fail "empty group name in '$GROUPS_ARG'"
  getent group "$g" >/dev/null || fail "unknown group: $g"
done
GROUPS_CSV=$(IFS=,; printf '%s' "${GROUP_ARR[*]-}")

if [[ -z $SUDO_ARG ]]; then
  if interactive; then
    need_gum
    choice=$(gum choose --header="Sudo for $USERNAME?" "Password sudo" "Passwordless sudo" "No sudo") || fail "cancelled"
    case "$choice" in
    "Password sudo") SUDO_ARG="sudo" ;;
    "Passwordless sudo") SUDO_ARG="sudo-nopasswd" ;;
    *) SUDO_ARG="no-sudo" ;;
    esac
  else
    SUDO_ARG="no-sudo"
  fi
fi

if (( ! SKIP_PASSWORD )) && ! interactive; then
  fail "setting a password needs a terminal; pass --skip-password or run interactively"
fi

if [[ -x /usr/bin/bash ]]; then
  USER_SHELL=/usr/bin/bash
else
  USER_SHELL=/bin/bash
fi

echo
echo "About to create:"
echo "  user:   $USERNAME (shell $USER_SHELL)"
echo "  groups: ${GROUPS_CSV:-<none>}"
echo "  sudo:   $SUDO_ARG"
if [[ ",$GROUPS_CSV," == *,wheel,* ]]; then
  echo "  note:   wheel makes $USERNAME an administrator (root via pkexec/run0 with their own password)"
fi
confirm "Create user $USERNAME?" || fail "aborted"

sudo useradd -m -s "$USER_SHELL" "$USERNAME"
if [[ -n $GROUPS_CSV ]]; then
  sudo usermod -aG "$GROUPS_CSV" "$USERNAME"
fi

if (( SKIP_PASSWORD )); then
  echo "Skipped password (--skip-password). SDDM needs one: run 'sudo passwd $USERNAME'."
else
  echo "Set the password for $USERNAME:"
  sudo passwd "$USERNAME"
fi

if [[ $SUDO_ARG == "sudo" || $SUDO_ARG == "sudo-nopasswd" ]]; then
  if [[ $SUDO_ARG == "sudo-nopasswd" ]]; then
    sudoers_line="$USERNAME ALL=(ALL) NOPASSWD: ALL"
  else
    sudoers_line="$USERNAME ALL=(ALL) ALL"
  fi
  # Validate before installing: a broken drop-in in /etc/sudoers.d can
  # take sudo down for everyone.
  sudoers_tmp=$(mktemp)
  printf '%s\n' "$sudoers_line" >"$sudoers_tmp"
  if ! sudo visudo -cf "$sudoers_tmp" >/dev/null; then
    rm -f -- "$sudoers_tmp"
    fail "generated sudoers rule failed validation, nothing written"
  fi
  sudo install -m 0440 -o root -g root -- "$sudoers_tmp" "$sudoers_file"
  rm -f -- "$sudoers_tmp"
  sudo visudo -c
  echo "Sudo ($SUDO_ARG) granted via $sudoers_file."
fi

echo
echo "Created $USERNAME: $(id "$USERNAME")"
echo "First graphical login provisions the desktop (or run 'omarchy-provision-user' as $USERNAME)."
