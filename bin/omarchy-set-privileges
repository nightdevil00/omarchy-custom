#!/bin/bash

# omarchy:summary=Set a user's sudo level: password, passwordless, or none
# omarchy:args=[username] [--level password|nopasswd|none] [--yes] [--force-lockout]
# omarchy:examples=omarchy-set-privileges | omarchy-set-privileges alice --level nopasswd --yes

set -euo pipefail

PROG="omarchy-set-privileges"
ASSUME_YES=0
FORCE_LOCKOUT=0
USERNAME=""
LEVEL=""

fail() {
  echo "$PROG: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

show_logo() {
  if interactive && [[ -n ${OMARCHY_PATH:-} && -f $OMARCHY_PATH/logo.txt ]]; then
    echo -e "\033[32m"
    cat <"$OMARCHY_PATH/logo.txt"
    echo -e "\033[0m"
    echo
  fi
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

need_gum() {
  command -v gum >/dev/null 2>&1 || fail "gum is required for the interactive menu"
}

login_users() {
  getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | sort
}

# A managed file contains exactly one of the rules this tool writes, including
# its final newline. Do not mistake a matching line in a larger file for ours.
managed_sudoers_file() {
  local file=$1 user=$2 rule
  sudo test -f "$file" && ! sudo test -L "$file" || return 1
  for rule in "$user ALL=(ALL) ALL" "$user ALL=(ALL) NOPASSWD: ALL"; do
    if sudo cat -- "$file" | cmp -s - <(printf '%s\n' "$rule"); then
      return 0
    fi
  done
  return 1
}

# Only an unrestricted rule such as "(ALL) ALL" or "(ALL : ALL) NOPASSWD: ALL"
# counts; a grant limited to some commands does not make an administrator.
full_sudo_grant() {
  local list
  list=$(LC_ALL=C sudo -l -U "$1" 2>/dev/null) || return 1
  grep -Eq '^[[:space:]]*\((ALL|root)([[:space:]]*:[^)]*)?\)[[:space:]]+([A-Z]+:[[:space:]]*)*ALL[[:space:]]*$' <<<"$list"
}

# Another login user counts as an administrator through wheel or an
# unrestricted sudo grant.
other_admin_exists() {
  local candidate groups
  while IFS= read -r candidate; do
    [[ $candidate != "$USERNAME" ]] || continue
    groups=$(id -nG "$candidate") || groups=""
    [[ " $groups " == *" wheel "* ]] && return 0
    full_sudo_grant "$candidate" && return 0
  done < <(login_users)
  return 1
}

while (( $# > 0 )); do
  case "$1" in
  --level)
    [[ -n ${2:-} && $2 != -* ]] || fail "--level needs one of: password, nopasswd, none"
    LEVEL="$2"
    shift 2
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  --force-lockout)
    FORCE_LOCKOUT=1
    shift
    ;;
  -h | --help)
    echo "Usage: $PROG [username] [--level password|nopasswd|none] [--yes] [--force-lockout]"
    echo
    echo "Sets a user's sudo level through a validated /etc/sudoers.d/<username>"
    echo "drop-in: password sudo, passwordless sudo, or no sudo grant."
    echo "'none' removes only a drop-in containing exactly one managed rule,"
    echo "then reports whether another sudo rule still grants access, no"
    echo "sudo access remains, or the check could not be completed."
    echo "Removing your own sudo, or removing sudo when no other administrator"
    echo "(wheel member or full sudo grant) would remain, needs --force-lockout,"
    echo "even with --yes."
    echo
    echo "With no arguments it walks you through each step with gum."
    exit 0
    ;;
  -*)
    fail "unknown option: $1 (try --help)"
    ;;
  *)
    [[ -z $USERNAME ]] || fail "unexpected argument: $1"
    USERNAME="$1"
    shift
    ;;
  esac
done

[[ -z $LEVEL || $LEVEL == password || $LEVEL == nopasswd || $LEVEL == none ]] ||
  fail "--level must be one of: password, nopasswd, none"

show_logo

if [[ -z $USERNAME ]]; then
  interactive || fail "a username is required"
  need_gum
  USERNAME=$(login_users | gum choose --header="Set privileges for which user?") || fail "cancelled"
  [[ -n $USERNAME ]] || fail "nothing selected"
fi
entry=$(getent passwd "$USERNAME") || fail "no such user: $USERNAME"
IFS=: read -r name _ uid _ <<<"$entry"
[[ $name == "$USERNAME" ]] || fail "no such user: $USERNAME (use the login name, not a UID)"
(( uid >= 1000 && uid < 60000 )) || fail "refusing to manage sudo for system account '$USERNAME' (UID $uid)"
# sudo silently skips drop-ins whose name contains '.' or ends in '~'.
[[ $USERNAME != *.* && $USERNAME != *~ ]] || fail "sudo ignores /etc/sudoers.d/$USERNAME ('.' or trailing '~' in the name)"

if [[ -z $LEVEL ]]; then
  interactive || fail "--level is required (password, nopasswd, none)"
  need_gum
  choice=$(gum choose --header="Sudo level for $USERNAME?" "Password sudo" "Passwordless sudo" "No sudo") || fail "cancelled"
  case "$choice" in
  "Password sudo") LEVEL="password" ;;
  "Passwordless sudo") LEVEL="nopasswd" ;;
  *) LEVEL="none" ;;
  esac
fi

sudoers_file="/etc/sudoers.d/$USERNAME"

if [[ $LEVEL == "none" ]]; then
  if sudo test -e "$sudoers_file" || sudo test -L "$sudoers_file"; then
    managed_sudoers_file "$sudoers_file" "$USERNAME" ||
      fail "$sudoers_file is not exactly one managed rule for $USERNAME. Inspect it with 'sudo visudo -f $sudoers_file' before changing this account"
    if (( ! FORCE_LOCKOUT )); then
      [[ $USERNAME != "${SUDO_USER:-$(id -un)}" ]] ||
        fail "refusing to remove your own sudo. Sign in as another administrator, or use --force-lockout only with a recovery path"
      groups=$(id -nG "$USERNAME") || fail "cannot read groups for $USERNAME"
      if [[ " $groups " != *" wheel "* ]] && ! other_admin_exists; then
        fail "no other administrator would remain. Add another login user to wheel first, or use --force-lockout only with a recovery path"
      fi
    fi
    echo "About to remove managed sudo grant $sudoers_file."
    confirm "Remove managed sudo grant for $USERNAME?" || fail "aborted"
    # Recheck immediately before deletion in case the file changed.
    managed_sudoers_file "$sudoers_file" "$USERNAME" || fail "$sudoers_file changed; inspect it with 'sudo visudo -f $sudoers_file' before retrying"
    sudo rm -- "$sudoers_file"
    echo "Removed managed sudo grant $sudoers_file."
  else
    echo "$USERNAME has no managed sudoers drop-in; nothing to remove."
  fi
  # LC_ALL=C keeps sudo's "not allowed" wording matchable.
  if sudo_list=$(LC_ALL=C sudo -l -U "$USERNAME" 2>&1); then
    echo "WARNING: $USERNAME still has effective sudo privileges from another rule." >&2
    printf '%s\n' "$sudo_list" >&2
    echo "Next: review /etc/sudoers and /etc/sudoers.d as an administrator, change the other grant with visudo, then run 'sudo -l -U $USERNAME' again." >&2
  elif [[ $sudo_list == *"is not allowed to run sudo"* ]]; then
    echo "Confirmed: no sudo access remains for $USERNAME."
  else
    echo "Could not verify whether $USERNAME still has sudo access. 'sudo -l -U $USERNAME' reported:" >&2
    printf '%s\n' "$sudo_list" >&2
    echo "Next: run 'sudo -l -U $USERNAME' from a root or other administrator session before assuming access was removed." >&2
  fi
  exit 0
fi

if [[ $LEVEL == "nopasswd" ]]; then
  sudoers_line="$USERNAME ALL=(ALL) NOPASSWD: ALL"
else
  sudoers_line="$USERNAME ALL=(ALL) ALL"
fi

echo
echo "About to set:"
echo "  user:  $USERNAME"
echo "  level: $LEVEL"
confirm "Grant $LEVEL sudo to $USERNAME?" || fail "aborted"

if sudo test -e "$sudoers_file" || sudo test -L "$sudoers_file"; then
  managed_sudoers_file "$sudoers_file" "$USERNAME" ||
    fail "$sudoers_file is not exactly one managed rule for $USERNAME. Inspect it with 'sudo visudo -f $sudoers_file'; this tool will not overwrite it"
fi

# Validate before installing: a broken drop-in in /etc/sudoers.d can
# take sudo down for everyone.
sudoers_tmp=$(mktemp)
printf '%s\n' "$sudoers_line" >"$sudoers_tmp"
if ! sudo visudo -cf "$sudoers_tmp" >/dev/null; then
  rm -f -- "$sudoers_tmp"
  fail "generated sudoers rule failed validation, nothing written"
fi
sudo install -m 0440 -o root -g root -- "$sudoers_tmp" "$sudoers_file"
rm -f -- "$sudoers_tmp"
sudo visudo -c
echo "Sudo ($LEVEL) granted to $USERNAME via $sudoers_file."
